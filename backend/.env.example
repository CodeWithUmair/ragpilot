# RagPilot API configuration. Copy to backend/.env and fill in.
# In docker-compose, DATABASE_URL / APP_ENV / PORT are overridden by the compose file.

# ─── Runtime ─────────────────────────────────────────────────────────────────
# development | production | test   (NODE_ENV is accepted as an alias)
APP_ENV=development
PORT=4000
# Plain postgresql:// URL; the app switches it to asyncpg itself.
# Local dev with docker-compose.dev.yml:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragpilot

# ─── Auth ────────────────────────────────────────────────────────────────────
# Signs session tokens and email-verification links. BETTER_AUTH_SECRET is
# accepted as an alias. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# false = users can sign in without clicking the verification email (demo mode).
REQUIRE_EMAIL_VERIFICATION=false
# Google OAuth (optional). Authorized redirect URI:
#   https://rag.umairamir.com/api/auth/callback/google   (prod)
#   http://localhost:4000/api/auth/callback/google       (dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── URLs / CORS ─────────────────────────────────────────────────────────────
# Frontend origin and public API origin (same origin in production).
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Extra exact origins allowed to call the protected API, comma-separated.
CORS_EXTRA_ORIGINS=
# Hostname suffixes allowed for the protected API, comma-separated.
CORS_ORIGIN_SUFFIXES=.vercel.app,.umairamir.com

# ─── LLM (any OpenAI-compatible provider) ────────────────────────────────────
OPENAI_API_KEY=
# Leave empty for OpenAI; set to e.g. https://api.groq.com/openai/v1 or a local
# vLLM/Ollama endpoint to switch providers.
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small
# Must match the vector(1024) column; do not change after data is ingested.
OPENAI_EMBED_DIMENSIONS=1024
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Email (first configured transport wins: Resend -> Gmail -> SMTP -> log) ─
RESEND_API_KEY=
GMAIL_USER=
# Google account "App password" (requires 2FA), not the normal password.
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=RagPilot

# ─── Access ──────────────────────────────────────────────────────────────────
# Comma-separated emails with admin rights (ADMIN_EMAIL also accepted).
ADMIN_EMAILS=
# Comma-separated emails that get the Pro plan without paying (testing).
TEST_PRO_EMAILS=

# Lemon Squeezy billing (Pro subscription). Leave empty to disable checkout.
# API key: Settings > API. Store/variant ids: from the store and the Pro product's variant.
# Webhook: Settings > Webhooks, URL <API_URL>/api/billing/webhook, events subscription_*; the
# signing secret you type there is LEMONSQUEEZY_WEBHOOK_SECRET.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional: build/version identifier reported by /version.
GIT_SHA=
